# Copy to .env and fill in. All secrets are required; compose refuses to start with empty values.
# Generate them with:  openssl rand -hex 32
# Use URL-safe values (hex is fine): passwords are embedded into connection URLs.

POSTGRES_USER=payments
POSTGRES_PASSWORD=
POSTGRES_DB=payments

RABBITMQ_USER=payments
RABBITMQ_PASSWORD=

# Clients send it in X-API-Key. At least 32 characters.
API_KEY=
# HMAC-SHA256 key for the X-Webhook-Signature header. At least 32 characters.
WEBHOOK_SECRET=

# Optional
API_PORT=8000
DOCS_ENABLED=false
MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=2000
# Local development only: allow webhooks to localhost / private networks / internal hostnames.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
